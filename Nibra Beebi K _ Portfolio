@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; scroll-behavior: smooth; }

body { font-family: Arial, Helvetica, sans-serif; background: rgb(247, 248, 252); color: rgb(34, 34, 34); line-height: 1.6; }

nav { position: fixed; top: 0px; width: 100%; background: rgb(17, 24, 39); padding: 18px 8%; display: flex; justify-content: space-between; align-items: center; z-index: 1000; }

.logo { color: white; font-size: 24px; font-weight: bold; }

.logo span { color: rgb(99, 102, 241); }

nav ul { display: flex; list-style: none; gap: 30px; }

nav ul li a { color: white; text-decoration: none; font-size: 15px; transition: 0.3s; }

nav ul li a:hover { color: rgb(129, 140, 248); }

.hero { min-height: 100vh; display: flex; justify-content: center; align-items: center; text-align: center; padding: 100px 20px 60px; background: linear-gradient(135deg, rgb(17, 24, 39), rgb(49, 46, 129)); color: white; }

.hero-content { max-width: 800px; }

.hero h1 { font-size: 55px; margin-bottom: 10px; }

.hero h1 span { color: rgb(129, 140, 248); }

.hero h2 { font-size: 25px; font-weight: normal; margin-bottom: 20px; }

.hero p { color: rgb(209, 213, 219); max-width: 650px; margin: auto; font-size: 17px; }

.buttons { margin-top: 30px; }

.btn { display: inline-block; padding: 12px 25px; margin: 5px; border-radius: 30px; text-decoration: none; font-weight: bold; transition: 0.3s; }

.primary { background: rgb(99, 102, 241); color: white; }

.primary:hover { background: rgb(79, 70, 229); transform: translateY(-3px); }

.secondary { border: 2px solid rgb(129, 140, 248); color: white; }

.secondary:hover { background: rgb(129, 140, 248); }

section { padding: 80px 8%; }

.section-title { text-align: center; margin-bottom: 45px; }

.section-title h2 { font-size: 35px; color: rgb(17, 24, 39); }

.section-title p { color: rgb(107, 114, 128); }

.about { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }

.about-text h3 { font-size: 28px; margin-bottom: 15px; color: rgb(49, 46, 129); }

.about-text p { color: rgb(85, 85, 85); margin-bottom: 15px; }

.contact-box { background: white; padding: 25px; border-radius: 15px; box-shadow: rgba(0, 0, 0, 0.08) 0px 5px 20px; }

.contact-box p { margin: 12px 0px; }

.contact-box strong { color: rgb(49, 46, 129); }

.education-container { max-width: 800px; margin: auto; }

.education-card { background: white; padding: 25px; margin-bottom: 20px; border-left: 5px solid rgb(99, 102, 241); border-radius: 10px; box-shadow: rgba(0, 0, 0, 0.07) 0px 5px 18px; }

.education-card h3 { color: rgb(49, 46, 129); margin-bottom: 5px; }

.education-card span { color: rgb(99, 102, 241); font-weight: bold; }

.skills-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

.skill-card { background: white; padding: 30px 20px; text-align: center; border-radius: 15px; box-shadow: rgba(0, 0, 0, 0.07) 0px 5px 18px; transition: 0.3s; }

.skill-card:hover { transform: translateY(-8px); }

.skill-card h3 { color: rgb(49, 46, 129); margin-bottom: 10px; }

.skill-card p { color: rgb(102, 102, 102); }

.certifications { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

.cert-card { background: white; padding: 25px; border-radius: 15px; box-shadow: rgba(0, 0, 0, 0.07) 0px 5px 18px; }

.cert-card h3 { color: rgb(49, 46, 129); margin-bottom: 10px; }

.cert-card span { color: rgb(99, 102, 241); font-size: 14px; font-weight: bold; }

.abilities { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

.ability { background: rgb(17, 24, 39); color: white; padding: 25px; border-radius: 15px; text-align: center; }

.ability h3 { color: rgb(129, 140, 248); margin-bottom: 10px; }

.contact { background: rgb(17, 24, 39); color: white; text-align: center; }

.contact h2 { font-size: 35px; margin-bottom: 15px; }

.contact p { color: rgb(209, 213, 219); margin: 8px; }

.contact a { color: rgb(129, 140, 248); text-decoration: none; }

footer { background: rgb(3, 7, 18); color: rgb(156, 163, 175); text-align: center; padding: 20px; font-size: 14px; }

@media (max-width: 900px) {
  nav { padding: 15px 5%; }
  nav ul { gap: 15px; }
  .hero h1 { font-size: 42px; }
  .about { grid-template-columns: 1fr; }
  .skills-container, .certifications { grid-template-columns: repeat(2, 1fr); }
  .abilities { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  nav { flex-direction: column; gap: 10px; }
  nav ul { gap: 12px; flex-wrap: wrap; justify-content: center; }
  .hero h1 { font-size: 34px; }
  .hero h2 { font-size: 20px; }
  section { padding: 60px 5%; }
  .skills-container, .certifications, .abilities { grid-template-columns: 1fr; }
  .section-title h2 { font-size: 28px; }
}
